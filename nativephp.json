{
    "namespace": "Network",
    "bridge_functions": [
        {
            "name": "Network.Status",
            "android": "com.nativephp.network.NetworkFunctions.Status",
            "ios": "NetworkFunctions.Status",
            "description": "Get the current network connection status"
        }
    ],
    "android": {
        "init_function": "com.nativephp.network.networkInit",
        "min_version": 26,
        "permissions": [
            "android.permission.ACCESS_NETWORK_STATE"
        ],
        "dependencies": {
            "implementation": []
        }
    },
    "ios": {
        "init_function": "networkInit",
        "min_version": "18.2",
        "info_plist": {},
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },
    "events": [
        "NativePHP\\Network\\Events\\NetworkStatusChanged"
    ]
}
